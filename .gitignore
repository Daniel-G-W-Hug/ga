# Build output
build/

# Python virtual environments (ga_bindgen/.venv and ga_py/.venv)
.venv/
.venv_*/

# Python bytecode
__pycache__/
*.py[cod]
*.pyo

# Test artifacts
.hypothesis/
.pytest_cache/

# Compiled Python extension modules (built into build/, not source tree)
*.pyd
*.so

# Editor / IDE caches
.VSCodeCounter/

# Track the repo-local .clang-format despite a global "ignore all dotfiles" (.*) rule that
# some maintainers keep in ~/.gitignore. Committing it gives co-workers identical formatting
# without depending on their personal global config.
!.clang-format
